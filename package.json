{
  "name": "rem-design-system",
  "version": "0.1.0",
  "private": true,
  "description": "Rem Design System — single-source design tokens (tokens.json -> SwiftUI + CSS) and human/agent-readable component docs for the Rem iOS + macOS app.",
  "type": "module",
  "scripts": {
    "tokens": "node tools/generate-tokens.mjs",
    "check-tokens": "node tools/generate-tokens.mjs --check",
    "build": "node tools/build-site.mjs",
    "manifest": "node tools/build-manifest.mjs",
    "check-manifest": "node tools/build-manifest.mjs --check",
    "check-code-connect:types": "tsc --project tsconfig.code-connect.json",
    "check-code-connect:swiftui": "figma connect parse --config figma.swiftui.config.json --exit-on-unreadable-files",
    "check-code-connect:compose": "figma connect parse --config figma.compose.config.json --exit-on-unreadable-files",
    "check-code-connect": "npm run check-code-connect:types && npm run check-code-connect:swiftui && npm run check-code-connect:compose"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Rem-Assistant/Rem-Design-System.git"
  },
  "license": "MIT",
  "dependencies": {
    "marked": "^18.0.14"
  },
  "devDependencies": {
    "@figma/code-connect": "^1.4.9"
  }
}
