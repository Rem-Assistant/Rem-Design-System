{
  "$schema-note": "SEED. Platform-neutral single source for Rem design tokens. Two token kinds: 'value' (a literal identical on every platform) and 'reference' (aliases a platform system color; Swift keeps the native reference, web uses an approximate hex). Generators MUST branch on $kind. Values captured from Shared/Views/DesignTokens.swift on 2026-09-23; web hex for reference tokens are approximations of Apple's system palette and must be verified against the Native reference app (CLAUDE.md principle 6) before being called canonical.",
  "$version": "0.1.0-seed",

  "spacing": {
    "$kind": "value", "$type": "dimension", "$unit": "pt",
    "xs": 4, "sm": 8, "md": 12, "lg": 16, "xl": 24, "xxl": 48, "xxxl": 120
  },

  "radius": {
    "$kind": "value", "$type": "dimension", "$unit": "pt",
    "$note": "RENAMED 2026-09-23 to a monotonic scale (small<medium<large<xlarge). Value multiset unchanged {8,12,16,24}; only the names moved. CUTOVER: Swift/CSS call sites using the OLD names must swap — old large(24)->xlarge, old xlarge(16)->large. See SPEC 'Cutover plan'.",
    "small": 8, "medium": 12, "large": 16, "xlarge": 24
  },

  "opacity": {
    "$kind": "value", "$type": "number",
    "deemphasized": { "value": 0.55, "$note": "Receded-but-real rows (blocked/stale). Apply ONCE per row; stacking multiplies to ~0.30 and reads as broken." }
  },

  "typography": {
    "$kind": "value", "$type": "typography",
    "$note": "DYNAMIC TYPE adopted 2026-09-23. Each role maps to an Apple Font.TextStyle so Swift emits SCALING fonts. Lucky break: every current size already equals Apple's default (Large) Dynamic Type size, so the default appearance is UNCHANGED — the app just gains scaling. Swift generates Font.<textStyle> (+ .weight()/.monospaced()); web keeps the fixed px 'size'. Weights: regular=400, bold=700.",
    "fontFamily": { "value": "-apple-system, system-ui, sans-serif", "$note": "Platform system font by design (San Francisco on Apple). No webfont." },
    "fontFamilyMono": { "value": "ui-monospace, SFMono-Regular, Menlo, monospace" },
    "roles": {
      "largeTitle":    { "size": 34, "weight": 400, "textStyle": "largeTitle" },
      "title1":        { "size": 28, "weight": 400, "textStyle": "title" },
      "title1Bold":    { "size": 28, "weight": 700, "textStyle": "title" },
      "title3":        { "size": 20, "weight": 400, "letterSpacing": -0.45, "textStyle": "title3" },
      "title3Bold":    { "size": 20, "weight": 700, "letterSpacing": -0.45, "textStyle": "title3" },
      "body":          { "size": 17, "weight": 400, "textStyle": "body" },
      "bodyBold":      { "size": 17, "weight": 700, "textStyle": "body" },
      "subheadline":   { "size": 15, "weight": 400, "textStyle": "subheadline" },
      "footnote":      { "size": 13, "weight": 400, "textStyle": "footnote" },
      "caption1":      { "size": 12, "weight": 400, "textStyle": "caption" },
      "caption1Bold":  { "size": 12, "weight": 700, "textStyle": "caption" },
      "chatCode":      { "size": 17, "weight": 400, "family": "mono", "textStyle": "body" }
    },
    "roleAliases": {
      "$note": "Chat text roles reuse base roles for one readable scale across iOS + Mac.",
      "chatMessage": "body", "chatMeta": "footnote", "chatChrome": "caption1"
    }
  },

  "color": {
    "brand": {
      "blue": { "$kind": "value", "$type": "color", "value": "#0C50FF", "$note": "Fixed, non-adaptive brand blue." },
      "blueOnFill": {
        "$kind": "value", "$type": "color",
        "$note": "Brand blue for tinted text on a subtle gray fill. Brightened in dark mode so Connect/Install CTAs clear WCAG AA (~4.7:1) on the dark pill.",
        "light": "#0C50FF", "dark": "#6E9BFF"
      }
    },

    "background": {
      "primary": {
        "$kind": "reference", "$type": "color",
        "swift": { "ios": "SwiftUI.Color(.systemBackground)", "macos": "SwiftUI.Color(nsColor: .windowBackgroundColor)" },
        "web": { "light": "#FFFFFF", "dark": "#000000", "$approximate": true }
      },
      "secondary": {
        "$kind": "reference", "$type": "color",
        "swift": { "ios": "SwiftUI.Color(.secondarySystemBackground)", "macos": "SwiftUI.Color(nsColor: .controlBackgroundColor)" },
        "web": { "light": "#F2F2F7", "dark": "#1C1C1E", "$approximate": true }
      },
      "tertiary": {
        "$kind": "reference", "$type": "color",
        "swift": { "ios": "SwiftUI.Color(.tertiarySystemBackground)", "macos": "SwiftUI.Color(nsColor: .textBackgroundColor)" },
        "web": { "light": "#FFFFFF", "dark": "#2C2C2E", "$approximate": true }
      }
    },

    "label": {
      "primary": {
        "$kind": "reference", "$type": "color",
        "swift": { "ios": "SwiftUI.Color(.label)", "macos": "SwiftUI.Color(nsColor: .labelColor)" },
        "web": { "light": "rgba(0,0,0,1)", "dark": "rgba(255,255,255,1)", "$approximate": true }
      },
      "secondary": {
        "$kind": "reference", "$type": "color",
        "swift": { "ios": "SwiftUI.Color(.secondaryLabel)", "macos": "SwiftUI.Color(nsColor: .secondaryLabelColor)" },
        "web": { "light": "rgba(60,60,67,0.6)", "dark": "rgba(235,235,245,0.6)", "$approximate": true }
      },
      "tertiary": {
        "$kind": "reference", "$type": "color",
        "swift": { "ios": "SwiftUI.Color(.tertiaryLabel)", "macos": "SwiftUI.Color(nsColor: .tertiaryLabelColor)" },
        "web": { "light": "rgba(60,60,67,0.3)", "dark": "rgba(235,235,245,0.3)", "$approximate": true }
      }
    },

    "separator": {
      "$kind": "reference", "$type": "color",
      "swift": { "ios": "SwiftUI.Color(.separator)", "macos": "SwiftUI.Color(nsColor: .separatorColor)" },
      "web": { "light": "rgba(60,60,67,0.29)", "dark": "rgba(84,84,88,0.6)", "$approximate": true }
    },

    "fill": {
      "tertiary": {
        "$kind": "reference", "$type": "color",
        "swift": { "ios": "SwiftUI.Color(.tertiarySystemFill)", "macos": "SwiftUI.Color(nsColor: .quaternaryLabelColor)" },
        "web": { "light": "rgba(118,118,128,0.12)", "dark": "rgba(118,118,128,0.24)", "$approximate": true }
      }
    },

    "buttonBackground": {
      "$kind": "reference", "$type": "color",
      "$note": "Maps to the label color (inverted-fill primary button).",
      "swift": { "ios": "SwiftUI.Color(.label)", "macos": "SwiftUI.Color(nsColor: .labelColor)" },
      "web": { "light": "rgba(0,0,0,1)", "dark": "rgba(255,255,255,1)", "$approximate": true }
    },

    "pillBackground": {
      "$kind": "reference", "$type": "color",
      "swift": { "ios": "SwiftUI.Color(.secondarySystemBackground)", "macos": "SwiftUI.Color(nsColor: .quaternaryLabelColor).opacity(0.3)" },
      "web": { "light": "#F2F2F7", "dark": "#1C1C1E", "$approximate": true }
    },

    "system": {
      "$kind": "reference", "$type": "color",
      "$note": "SwiftUI semantic accents; web values approximate Apple's published system palette (light/dark).",
      "blue":   { "swift": "SwiftUI.Color.blue",   "web": { "light": "#007AFF", "dark": "#0A84FF", "$approximate": true } },
      "green":  { "swift": "SwiftUI.Color.green",  "web": { "light": "#34C759", "dark": "#30D158", "$approximate": true } },
      "red":    { "swift": "SwiftUI.Color.red",    "web": { "light": "#FF3B30", "dark": "#FF453A", "$approximate": true } },
      "yellow": { "swift": "SwiftUI.Color.yellow", "web": { "light": "#FFCC00", "dark": "#FFD60A", "$approximate": true } },
      "orange": { "swift": "SwiftUI.Color.orange", "web": { "light": "#FF9500", "dark": "#FF9F0A", "$approximate": true } },
      "indigo": { "swift": "SwiftUI.Color.indigo", "web": { "light": "#5856D6", "dark": "#5E5CE6", "$approximate": true } },
      "purple": { "swift": "SwiftUI.Color.purple", "web": { "light": "#AF52DE", "dark": "#BF5AF2", "$approximate": true } }
    }
  }
}
